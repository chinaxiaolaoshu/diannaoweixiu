# ============ 仅服务端变量（严禁添加 NEXT_PUBLIC_ 前缀）============
# Neon PostgreSQL 连接串
DATABASE_URL=postgresql://user:pass@xxx.neon.tech/lovekk?sslmode=require
# Auth.js 密钥（openssl rand -base64 32），仅 apps/admin 需要
AUTH_SECRET=
# 前台正式地址（用于 canonical / sitemap / 推送）
SITE_URL=https://www.0913610.xyz
# admin 触发前台 ISR 刷新的共享密钥
REVALIDATE_SECRET=
# Cloudflare R2 对象存储（S3 兼容），仅 apps/admin 需要
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lovekk-media
R2_PUBLIC_URL=https://cdn.0913610.xyz
# 百度主动推送 Token（可选，留空则不推送）
BAIDU_PUSH_TOKEN=

# ============ 可暴露给浏览器的变量 ============
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WECHAT=
