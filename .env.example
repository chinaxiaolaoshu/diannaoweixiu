# ============ 仅服务端变量（严禁添加 NEXT_PUBLIC_ 前缀）============
# PostgreSQL 连接串（Supabase: Project Settings -> Database -> Connection string -> URI，记得把 [YOUR-PASSWORD] 换成真实密码）
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres
# Auth.js 密钥（openssl rand -base64 32），仅 apps/admin 需要
AUTH_SECRET=
# 前台正式地址（用于 canonical / sitemap / 推送）
SITE_URL=https://www.0913610.xyz
# admin 触发前台 ISR 刷新的共享密钥
REVALIDATE_SECRET=
# Supabase REST (PostgREST)，仅 apps/web/middleware.ts 使用（Edge Runtime 不能走 TCP）
# SUPABASE_URL: Project Settings -> API -> Project URL
SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY: Project Settings -> API -> service_role（仅服务端，绝不暴露到浏览器）
SUPABASE_SERVICE_KEY=
# Cloudflare R2 对象存储（S3 兼容），仅 apps/admin 需要
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lovekk-media
R2_PUBLIC_URL=https://cdn.0913610.xyz
# 百度主动推送 Token（可选，留空则不推送）
BAIDU_PUSH_TOKEN=

# ============ 可暴露给浏览器的变量 = ============
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WECHAT=
